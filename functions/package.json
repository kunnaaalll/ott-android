{
  "name": "ott-functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:unit": "jest --testPathIgnorePatterns=integration.test.ts --forceExit --no-watchman",
    "test:integration": "jest --testMatch=\"**/*.integration.test.ts\" --forceExit --no-watchman",
    "test": "npm run test:unit"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.620.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/cloudfront-signer": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "sns-validator": "^0.3.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.0.0"
  },
  "private": true
}
